rules_version = '2';

// Golden Pearl News Network — Firestore Security Rules
// Pehchaan: OTP ke baad server ka custom token (token.phone) / admin login ka token (token.admin).
// Bharose wale kaam (referral reward, payment activation, press ID kram, rashifal) server Admin SDK se — rules ke bahar.
// Jo yahan allow nahi, wo band (default deny).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function phone() { return signedIn() ? request.auth.token.get('phone', '') : ''; }
    function hasPhone() { return phone() is string && phone().size() == 10; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }

    // Sirf yahi fields badle (baaki jaise ke taise)
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // Sirf ek counter, aur sirf +1 (views / clicks / impressions)
    function incOnly(field) {
      return changedOnly([field]) && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }
    // Profile ka maalik: naya id (prefix_phone) ya purane records me phone/mobile field
    function ownsProfile(prefix, id) {
      return hasPhone() && (id == prefix + phone()
        || (resource != null && (resource.data.get('phone', '') == phone() || resource.data.get('mobile', '') == phone())));
    }
    // Patrakar / advertiser ka record: server token me asli ID (rid/aid) deta hai — purane records bhi; warna naya naam
    function repId() { return request.auth.token.get('rid', 'rp_' + phone()); }
    function advId() { return request.auth.token.get('aid', 'adv_' + phone()); }
    function recordIsMine(data) { return data.get('phone', '') == phone() || data.get('mobile', '') == phone(); }
    function approvedReporter() {
      return hasPhone() && exists(docPath('reporters', repId()))
        && recordIsMine(get(docPath('reporters', repId())).data)
        && get(docPath('reporters', repId())).data.get('status', '').lower() in ['approved', 'active'];
    }
    // Patrakar seva sadasyata: is portal (siteId) ki chalu ho — ya purani (₹499) sadasyata
    function reporterMemberOn(site) {
      let r = get(docPath('reporters', repId())).data;
      return r.get('memberships', {}).get(site, {}).get('expiresAt', timestamp.value(0)) > request.time
        || r.get('membershipActive', false) == true;
    }
    function isAdvertiser() {
      return hasPhone() && exists(docPath('advertisers', advId()))
        && recordIsMine(get(docPath('advertisers', advId())).data);
    }

    // ---------- Admin: sab kuch ----------
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ---------- Public content: sab padhein, likhe sirf admin ----------
    match /sites/{id} { allow read: if true; }
    match /categories/{id} { allow read: if true; }
    match /states/{id} { allow read: if true; }
    match /cities/{id} { allow read: if true; }
    match /rashifal/{id} { allow read: if true; }
    match /live_blogs/{id} { allow read: if true; }
    match /videos/{id} { allow read: if true; }
    match /galleries/{id} { allow read: if true; }
    match /epaper/{id} { allow read: if true; }
    match /notifications/{id} { allow read: if true; }
    match /settings/{id} { allow read: if true; }

    // ---------- Khabrein ----------
    match /articles/{id} {
      allow read: if true;
      // Approved patrakar apni khabar review ke liye (publish sirf admin)
      allow create: if approvedReporter()
        && request.resource.data.authorIdentifier == phone()
        && request.resource.data.status in ['pending', 'pending_review', 'draft', 'Draft']
        && reporterMemberOn(request.resource.data.get('siteId', ''));
      // Koi bhi visitor: sirf views +1
      allow update: if incOnly('views');
    }

    // ---------- Vigyapan ----------
    // Advertiser ka vigyapan sirf server banata hai (/api/payments/confirm — Razorpay bhugtan jaanch ke baad, status pending)
    match /ads/{id} {
      allow read: if true;
      allow update: if incOnly('impressions') || incOnly('clicks');
    }
    match /advertisements/{id} {
      allow read: if true;
      allow update: if incOnly('clicks') || incOnly('impressions');
    }
    match /classifieds/{id} {
      allow read: if true;
    }

    // ---------- Pathakon ki tippaniyan ----------
    match /comments/{id} {
      allow read: if resource.data.status == 'approved';
      allow create: if hasPhone() && request.resource.data.status == 'pending';
    }

    // ---------- Shok sandesh: server-verified payment (₹11 = 7 din / ₹51 = 30 din) ki ID hi document ID ----------
    // Sabko sirf approved; banane wala (ownerPhone) apne sab sandesh dekh sake (download ke liye).
    match /shok_sandesh/{id} {
      allow read: if resource.data.status == 'approved'
        || (hasPhone() && resource.data.get('ownerPhone', '') == phone());
      allow create: if hasPhone()
        && exists(docPath('payments', id))
        && get(docPath('payments', id)).data.kind == 'shok'
        && get(docPath('payments', id)).data.get('phone', '') == phone()
        && request.resource.data.ownerPhone == phone()
        && request.resource.data.days == get(docPath('payments', id)).data.days
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentId == id;
    }

    // ---------- Pathak ----------
    match /users/{uid} {
      allow get: if hasPhone() && uid == 'u_' + phone();
      // Server tayyar na ho tab ka fallback signup — reward/counter fields khud nahi
      allow create: if hasPhone() && uid == 'u_' + phone()
        && request.resource.data.phone == phone()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'verified', 'referredBy', 'createdAt', 'consent'])
        && request.resource.data.get('referredBy', null) == null;
      allow update: if hasPhone() && uid == 'u_' + phone() && changedOnly(['name', 'email', 'consent']);
    }

    // ---------- Patrakar ----------
    match /reporters/{rid} {
      allow get: if ownsProfile('rp_', rid);
      allow list: if hasPhone() && (resource.data.get('phone', '') == phone() || resource.data.get('mobile', '') == phone());
      allow create: if hasPhone() && rid == 'rp_' + phone()
        && request.resource.data.phone == phone()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'phone', 'city', 'appliedFromSite', 'status', 'role', 'phoneVerified', 'consent', 'createdAt']);
      // Apni photo / blood group / kshetra / download ginti / sahmati — naam, padnaam, status, ID admin ke haath
      allow update: if ownsProfile('rp_', rid) && changedOnly([
        'photoUrl', 'photoUpdatedAt', 'bloodGroup', 'workArea', 'cardUpdatedAt',
        'idCardDownloads', 'certificateDownloads', 'lastCardDownloadAt', 'consent'
      ]);
    }

    // ---------- Vigyapandata ----------
    match /advertisers/{aid} {
      allow get: if ownsProfile('adv_', aid);
      allow list: if hasPhone() && (resource.data.get('phone', '') == phone() || resource.data.get('mobile', '') == phone());
      allow create: if hasPhone() && aid == 'adv_' + phone()
        && request.resource.data.phone == phone()
        && request.resource.data.keys().hasOnly(['businessName', 'contactName', 'phone', 'email', 'role', 'phoneVerified', 'consent', 'createdAt']);
      allow update: if ownsProfile('adv_', aid) && changedOnly(['consent']);
    }

    // ---------- Referral (likhna sirf server) ----------
    match /referrals/{id} {
      allow read: if hasPhone() && resource.data.referrerPhone == phone();
    }
    match /referral_rewards/{id} {
      allow read: if hasPhone() && resource.data.referrerPhone == phone();
    }

    // ---------- E-paper subscription (likhna sirf server: payment / referral) ----------
    match /epaper_subscriptions/{email} {
      allow read: if hasPhone() && (resource == null
        || resource.data.get('userPhone', '') == phone()
        || resource.data.get('userEmail', '') == request.auth.token.get('email', '-')
        || resource.data.get('userEmail', '') == phone() + '@news.local');
    }

    // ---------- Patrakar ke bhugtan (likhna sirf server) ----------
    match /membership_transactions/{id} {
      allow read: if hasPhone() && resource.data.reporterPhone == phone();
    }
    match /delivery_requests/{id} {
      allow read: if hasPhone() && resource.data.get('reporterPhone', '') == phone();
    }

    // ---------- DPDP sahmati ka record (sirf jodna) ----------
    match /consents/{id} {
      allow create: if hasPhone() && request.resource.data.phone == phone();
    }

    // ---------- Khata hatane ka anurodh (OTP-verified maalik) ----------
    match /account_deletion_requests/{p} {
      allow get: if hasPhone() && p == phone();
      allow create, update: if hasPhone() && p == phone()
        && request.resource.data.phone == p
        && request.resource.data.status == 'pending';
    }

    // readers (purana), referral_codes, counters, payments, vip_all_access, subscriptions:
    // sirf admin / server — upar wale admin niyam ke alawa koi allow nahi.

    // =====================================================================================
    // Mobile app (Golden Pearl News Android) — EXTRA ijazat.
    // Website ke upar wale niyam jaise ke taise hain; app ke apne features / price alag hain,
    // isliye uske kaam yahan alag se allow hain. Har jagah: sirf apna data, sirf tay fields,
    // koi khud ko approve / admin / inaam nahi de sakta, dusre ka data nahi padh sakta.
    // =====================================================================================

    // Record mera hai (app ke purane records random ID ke — phone / mobile field se pehchaan)
    function myRecord(data) { return hasPhone() && (data.get('phone', '') == phone() || data.get('mobile', '') == phone()); }
    // Likhne ke baad bhi record usi number ka rahe
    function keepsMyPhone() {
      return request.resource.data.get('phone', phone()) == phone()
        && request.resource.data.get('mobile', phone()) == phone();
    }
    // Sirf ye fields badle / bane
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    // Refer & Earn: naya pathak apne sign-up ke SAATH (isi batch me referrals/<apna number> banate hue) referrer ko sirf +1
    function referralCreditInThisBatch() {
      return hasPhone() && !exists(docPath('referrals', phone()))
        && existsAfter(docPath('referrals', phone()))
        && getAfter(docPath('referrals', phone())).data.get('refereePhone', '') == phone();
    }
    // Referral inaam lena: rewardsClaimed sirf +1, tabhi jab inaam bacha ho, aur saath me sirf ek pass ki tareekh
    function spendsOneReward() {
      return changedOnly(['rewardsClaimed', 'epaperPassUntil', 'allAppsPassUntil'])
        && request.resource.data.get('rewardsClaimed', 0) == resource.data.get('rewardsClaimed', 0) + 1
        && resource.data.get('referralCount', 0) > resource.data.get('rewardsClaimed', 0);
    }

    // App login / profile ke fields (role, status, verified, referral ginti, inaam — inme nahi)
    function userAppKeys() {
      return ['name', 'email', 'phone', 'mobile', 'isPhoneVerified', 'lastLoginAt', 'updatedAt', 'dpdpConsent',
        'consent', 'city', 'dob', 'gender', 'photoUrl', 'bio', 'interests', 'referralCode'];
    }
    // Sadasyata (memberships) sirf server likhta hai — payment jaanch ke baad (/api/payments/confirm)
    function reporterAppKeys() {
      return ['phone', 'mobile', 'isPhoneVerified', 'lastLoginAt', 'updatedAt', 'dpdpConsent', 'consent',
        'photoUrl', 'bloodGroup', 'workArea', 'state', 'pressPortalId'];
    }
    function advertiserAppKeys() {
      return ['phone', 'mobile', 'isPhoneVerified', 'lastLoginAt', 'updatedAt', 'dpdpConsent', 'consent',
        'name', 'email', 'companyName'];
    }

    // ---------- App: pathak khata ----------
    match /users/{uid} {
      allow get, list: if myRecord(resource.data);
      allow create: if myRecord(request.resource.data) && keepsMyPhone()
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('status', 'active') == 'active'
        && onlyKeys(['name', 'email', 'phone', 'mobile', 'role', 'status', 'isPhoneVerified', 'source',
          'lastLoginAt', 'updatedAt', 'createdAt', 'referralCode', 'referredBy', 'dpdpConsent', 'consent']);
      allow update: if myRecord(resource.data) && keepsMyPhone()
        && (changedOnly(userAppKeys()) || spendsOneReward());
      // Naya pathak ke sign-up ke saath referrer ko +1 (isi batch me referral record)
      allow update: if hasPhone() && changedOnly(['referralCount'])
        && request.resource.data.referralCount == resource.data.get('referralCount', 0) + 1
        && referralCreditInThisBatch();
      allow delete: if myRecord(resource.data);
    }

    // ---------- App: patrakar khata (status / ID / padnaam / membership sirf admin) ----------
    match /reporters/{rid} {
      allow create: if myRecord(request.resource.data) && keepsMyPhone()
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('role', 'reporter') == 'reporter'
        && onlyKeys(['name', 'email', 'phone', 'mobile', 'role', 'status', 'pressCardNo', 'isPhoneVerified', 'source',
          'lastLoginAt', 'updatedAt', 'createdAt', 'dpdpConsent', 'consent']);
      allow update: if myRecord(resource.data) && keepsMyPhone() && changedOnly(reporterAppKeys());
      allow delete: if myRecord(resource.data);
    }

    // ---------- App: vigyapandata khata ----------
    match /advertisers/{aid} {
      allow create: if myRecord(request.resource.data) && keepsMyPhone()
        && request.resource.data.get('role', 'advertiser') == 'advertiser'
        && onlyKeys(['name', 'email', 'companyName', 'phone', 'mobile', 'role', 'status', 'isPhoneVerified', 'source',
          'lastLoginAt', 'updatedAt', 'createdAt', 'dpdpConsent', 'consent']);
      allow update: if myRecord(resource.data) && keepsMyPhone() && changedOnly(advertiserAppKeys());
      allow delete: if myRecord(resource.data);
    }

    // ---------- App: patrakar ki khabar (review ke liye) ----------
    // Usi portal ki chalu sadasyata (₹999 / saal, har portal ki alag) wala patrakar; khabar hamesha pending, apne naam se
    match /articles/{id} {
      allow create: if hasPhone() && exists(docPath('reporters', repId()))
        && recordIsMine(get(docPath('reporters', repId())).data)
        && reporterMemberOn(request.resource.data.get('siteId', ''))
        && request.resource.data.get('status', '') == 'pending_admin_approval'
        && request.resource.data.get('approved', false) == false
        && request.resource.data.get('authorIdentifier', '') == phone();
    }

    // App ke vigyapan / classified bhi server banata hai (payment ke baad, 'pending'); shok sandesh upar wale
    // niyam se (payments/{id} ke saath) — app ke liye alag booking niyam nahi.

    // ---------- App: video like / unlike ----------
    match /videos/{id} {
      allow update: if changedOnly(['likes'])
        && (request.resource.data.likes == resource.data.get('likes', 0) + 1
          || request.resource.data.likes == resource.data.get('likes', 0) - 1);
    }

    // ---------- App: apni tippani hatana (khata hatate waqt) ----------
    match /comments/{id} {
      allow delete: if hasPhone() && resource.data.get('userPhone', '') == phone();
    }

    // ---------- App: sev ki gayi khabrein (id = <phone>_<articleId>) ----------
    match /bookmarks/{id} {
      allow read, delete: if hasPhone() && resource.data.get('userKey', '') == phone();
      allow create, update: if hasPhone() && request.resource.data.get('userKey', '') == phone()
        && id == phone() + '_' + request.resource.data.get('articleId', '');
    }

    // ---------- App: push notification token (ek device = ek document) ----------
    match /push_tokens/{token} {
      allow read, delete: if hasPhone() && resource.data.get('phone', '') == phone();
      allow create, update: if hasPhone() && request.resource.data.get('phone', '') == phone();
    }

    // ---------- App: Refer & Earn ----------
    // Login pathak ek code ka referrer dekh sake (list nahi); apna code darj / hata sake
    match /referral_codes/{code} {
      allow get: if hasPhone();
      allow create: if hasPhone() && request.resource.data.get('phone', '') == phone();
      allow delete: if hasPhone() && resource.data.get('phone', '') == phone();
    }
    // Naya pathak apna referral record (id = apna number); khata hatane par apna record / naam hata sake
    match /referrals/{refereePhone} {
      allow read: if hasPhone() && resource.data.get('refereePhone', '') == phone();
      allow create: if hasPhone() && refereePhone == phone()
        && request.resource.data.get('refereePhone', '') == phone()
        && request.resource.data.get('referrerPhone', '') != phone();
      allow update: if hasPhone() && resource.data.get('referrerPhone', '') == phone()
        && changedOnly(['referrerPhone', 'referrerName']);
      allow delete: if hasPhone() && resource.data.get('refereePhone', '') == phone();
    }
    match /referral_rewards/{id} {
      allow read: if hasPhone() && resource.data.get('phone', '') == phone();
      allow create: if hasPhone() && request.resource.data.get('phone', '') == phone();
    }

    // ---------- App: booking / anurodh ke records (admin dekhta hai) ----------
    match /press_card_deliveries/{id} { allow create: if hasPhone() && request.resource.data.get('status', '') == 'pending_dispatch'; }
    match /app_switch_subscriptions/{id} { allow create: if hasPhone(); }
    match /account_deletions/{id} { allow create: if hasPhone(); }
  }
}
